      "expect": [{ "rule": "parallel-perfect", "t": 4 }]
    },
    {
      "name": "ascending, direct",
      "voices": [
        { "name": "upper", "notes": [[72, 4], [74, 4]] },
        { "name": "lower", "notes": [[60, 4], [67, 4]] }
      ],
      "expect": [{ "rule": "hidden-perfect", "t": 4 }]
    },
    {
      "name": "ascending, filled in",
      "voices": [
        { "name": "upper", "notes": [[72, 4], [74, 4]] },
